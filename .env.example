# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are SAFE to ship to the browser: the anon/publishable key can
# only do what Row Level Security allows.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# NEVER put the service_role / secret key in any VITE_ variable.
