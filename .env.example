# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are SAFE to ship to the browser: the anon/publishable key can
# only do what Row Level Security allows.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional: shared VISITOR account for automatic sign-in (no login screen).
# These end up in the browser bundle, so only ever use a visitor-role account
# here — never the admin one. Leave unset to require normal sign-in.
# VITE_GUEST_EMAIL=
# VITE_GUEST_PASSWORD=

# NEVER put the service_role / secret key in any VITE_ variable.
